  <diagram id="m_11" name="Hình 3.3.4 Activity Khóa User"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
  <root>
    <mxCell id="0" /><mxCell id="1" parent="0" />
    <mxCell id="la_adm" value="Quản Trị Viên (Admin Dashboard)" style="swimlane;startSize=26;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="280" height="600" as="geometry" /></mxCell>
    <mxCell id="la_srv" value="Máy Chủ Backend &amp; DB" style="swimlane;startSize=26;fillColor=#F8FAFC;strokeColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="280" height="600" as="geometry" /></mxCell>
    <mxCell id="la_sock" value="Signaling Server &amp; User Socket" style="swimlane;startSize=26;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="280" height="600" as="geometry" /></mxCell>

    <mxCell id="ad_start" value="" style="ellipse;fillColor=#0F172A;" vertex="1" parent="la_adm"><mxGeometry x="125" y="40" width="30" height="30" as="geometry" /></mxCell>
    <mxCell id="ad_view" value="Xem danh sách người dùng vi phạm&#xa;trong Tab 'Quản lý Người Dùng'" style="rounded=1;fillColor=#FFFFFF;strokeColor=#DC2626;" vertex="1" parent="la_adm"><mxGeometry x="40" y="100" width="200" height="50" as="geometry" /></mxCell>
    <mxCell id="ad_click" value="Bấm 'Khóa tài khoản'&#xa;PUT /api/admin/users/:id/status" style="rounded=1;fillColor=#FFFFFF;strokeColor=#DC2626;" vertex="1" parent="la_adm"><mxGeometry x="50" y="180" width="180" height="45" as="geometry" /></mxCell>

    <mxCell id="ad_update" value="Cập nhật users SET status='SUSPENDED'&#xa;trong CSDL MySQL" style="rounded=1;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="la_srv"><mxGeometry x="40" y="180" width="200" height="45" as="geometry" /></mxCell>
    <mxCell id="ad_call_sock" value="Gọi disconnectUserSockets(io, userId)&#xa;truy tìm socket của user trong RAM" style="rounded=1;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="la_srv"><mxGeometry x="40" y="260" width="200" height="45" as="geometry" /></mxCell>

    <mxCell id="ad_emit" value="Phát sự kiện 'account-suspended'&#xa;&amp; socket.disconnect(true)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="la_sock"><mxGeometry x="40" y="260" width="200" height="50" as="geometry" /></mxCell>
    <mxCell id="ad_kick" value="Ép đăng xuất trên trình duyệt user,&#xa;hủy kết nối WebRTC &amp; chặn API tiếp theo" style="rounded=1;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="la_sock"><mxGeometry x="35" y="350" width="210" height="55" as="geometry" /></mxCell>

    <mxCell id="ad_ok" value="Thông báo: Đã khóa &amp; ngắt kết nối" style="rounded=1;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="la_adm"><mxGeometry x="50" y="450" width="180" height="45" as="geometry" /></mxCell>
    <mxCell id="ad_end" value="" style="ellipse;shape=endState;fillColor=#059669;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="la_adm"><mxGeometry x="125" y="530" width="30" height="30" as="geometry" /></mxCell>

    <mxCell id="ead1" style="strokeColor=#DC2626;" edge="1" parent="1" source="ad_start" target="ad_view"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead2" style="strokeColor=#DC2626;" edge="1" parent="1" source="ad_view" target="ad_click"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead3" style="strokeColor=#DC2626;" edge="1" parent="1" source="ad_click" target="ad_update"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead4" style="strokeColor=#0F172A;" edge="1" parent="1" source="ad_update" target="ad_call_sock"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead5" style="strokeColor=#2563EB;" edge="1" parent="1" source="ad_call_sock" target="ad_emit"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead6" style="strokeColor=#2563EB;" edge="1" parent="1" source="ad_emit" target="ad_kick"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="ead7" style="strokeColor=#059669;" edge="1" parent="1" source="ad_update" target="ad_ok"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="472" /></Array></mxGeometry></mxCell>
    <mxCell id="ead8" style="strokeColor=#059669;" edge="1" parent="1" source="ad_ok" target="ad_end"><mxGeometry relative="1" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram>
  <diagram id="m_12" name="Hình 3.4 ERD Cơ Sở Dữ Liệu"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0" /><mxCell id="1" parent="0" />

    <mxCell id="t_users" value="users&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  username: VARCHAR(50) [UK]&#xa;  anonymous_name: VARCHAR(50)&#xa;  avatar_url: VARCHAR(255)&#xa;  bio: TEXT&#xa;  recovery_email: VARCHAR(100)&#xa;  recovery_token_hash: VARCHAR(64)&#xa;  password_hash: VARCHAR(255)&#xa;  role: ENUM('user','admin')&#xa;  status: ENUM('ACTIVE','SUSPENDED','DELETED')&#xa;  is_guest: BOOLEAN&#xa;  last_login_at: TIMESTAMP&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="50" y="50" width="250" height="270" as="geometry" /></mxCell>

    <mxCell id="t_posts" value="posts&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  mood_tag: VARCHAR(30)&#xa;  content: TEXT&#xa;  is_private: BOOLEAN&#xa;  status: ENUM('PENDING','APPROVED','REJECTED')&#xa;  rejection_reason: VARCHAR(255)&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="250" height="210" as="geometry" /></mxCell>

    <mxCell id="t_comments" value="comments&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  post_id: VARCHAR(36) [FK]&#xa;  parent_id: VARCHAR(36) [FK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  author_name: VARCHAR(50)&#xa;  content: TEXT&#xa;  is_ai_bot: BOOLEAN&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="750" y="50" width="230" height="190" as="geometry" /></mxCell>

    <mxCell id="t_likes" value="post_likes&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  post_id: VARCHAR(36) [FK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="180" height="110" as="geometry" /></mxCell>

    <mxCell id="t_saved" value="saved_posts&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  post_id: VARCHAR(36) [FK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="610" y="310" width="180" height="110" as="geometry" /></mxCell>

    <mxCell id="t_reports" value="post_reports&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  post_id: VARCHAR(36) [FK]&#xa;  reporter_id: VARCHAR(36) [FK]&#xa;  reason: VARCHAR(255)&#xa;  details: TEXT&#xa;  status: ENUM('PENDING','REVIEWING','RESOLVED','REJECTED')&#xa;  resolved_by: VARCHAR(36)&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="250" height="180" as="geometry" /></mxCell>

    <mxCell id="t_ai_ses" value="ai_chat_sessions&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  title: VARCHAR(100)&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="220" height="120" as="geometry" /></mxCell>

    <mxCell id="t_ai_msg" value="ai_chat_messages&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  session_id: VARCHAR(36) [FK]&#xa;  sender: ENUM('user','heli')&#xa;  content: TEXT&#xa;  emotion_detected: VARCHAR(50)&#xa;  topic_detected: VARCHAR(50)&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="220" height="170" as="geometry" /></mxCell>

    <mxCell id="t_safety" value="safety_shield_logs&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  user_id: VARCHAR(36) [FK]&#xa;  risk_level: ENUM('SAFE','WARNING','DANGER')&#xa;  emergency_alert: BOOLEAN&#xa;  flagged_issues: TEXT&#xa;  advice: TEXT&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="250" height="160" as="geometry" /></mxCell>

    <mxCell id="t_p2p" value="chat_sessions (Signaling)&#xa;---------------------------------&#xa;* id: VARCHAR(36) [PK]&#xa;  peer_a_id: VARCHAR(36) [FK]&#xa;  peer_b_id: VARCHAR(36) [FK]&#xa;  topic: VARCHAR(50)&#xa;  status: ENUM('WAITING','CONNECTED','CLOSED')&#xa;  created_at: TIMESTAMP" style="swimlane;fontStyle=1;align=center;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="630" y="470" width="250" height="150" as="geometry" /></mxCell>

    <!-- Connectors -->
    <mxCell id="re_u_p" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1" source="t_users" target="t_posts"><mxGeometry relative="1" as="geometry" /></mxCell>
