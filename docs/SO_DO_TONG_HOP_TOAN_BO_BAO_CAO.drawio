    <mxCell id="re_p_l" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=diamond;endFill=1;strokeColor=#475569;" edge="1" parent="1" source="t_posts" target="t_likes"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="re_p_s" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=diamond;endFill=1;strokeColor=#475569;" edge="1" parent="1" source="t_posts" target="t_saved"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="re_p_r" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#DC2626;" edge="1" parent="1" source="t_posts" target="t_reports"><mxGeometry relative="1" as="geometry" /></mxCell>
