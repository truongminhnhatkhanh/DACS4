    <mxCell id="re_ai_m" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=diamond;endFill=1;strokeColor=#D97706;" edge="1" parent="1" source="t_ai_ses" target="t_ai_msg"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="re_u_safe" value="1..N" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;strokeColor=#DC2626;" edge="1" parent="1" source="t_users" target="t_safety"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="280" /><mxPoint x="310" y="520" /></Array></mxGeometry></mxCell>
  </root>
