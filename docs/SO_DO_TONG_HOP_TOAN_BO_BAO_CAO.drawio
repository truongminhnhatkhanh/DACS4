  <diagram id="m_13" name="Hình 3.5 Class Diagram"><mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Class: User -->
    <mxCell id="cls_user" value="User&#xa;---------------------------------&#xa;+ id: String [PK]&#xa;+ username: String&#xa;+ anonymous_name: String&#xa;+ avatar_url: String&#xa;+ bio: String&#xa;+ recovery_email: String&#xa;+ recovery_token_hash: String&#xa;+ password_hash: String&#xa;+ role: Enum('user', 'admin')&#xa;+ status: Enum('ACTIVE', 'SUSPENDED', 'DELETED')&#xa;+ is_guest: Boolean&#xa;+ last_login_at: Timestamp&#xa;+ created_at: Timestamp&#xa;---------------------------------&#xa;+ register()&#xa;+ login()&#xa;+ recoverWithCode()&#xa;+ updateProfile()&#xa;+ regenerateCode()&#xa;+ changePassword()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1">
      <mxGeometry x="50" y="80" width="240" height="340" as="geometry" />
    </mxCell>

    <!-- Class: Post -->
    <mxCell id="cls_post" value="Post&#xa;---------------------------------&#xa;+ id: String [PK]&#xa;+ user_id: String [FK]&#xa;+ mood_tag: String&#xa;+ content: Text&#xa;+ is_private: Boolean&#xa;+ status: Enum('PENDING', 'APPROVED', 'REJECTED')&#xa;+ rejection_reason: String&#xa;+ created_at: Timestamp&#xa;+ updated_at: Timestamp&#xa;---------------------------------&#xa;+ create()&#xa;+ update()&#xa;+ delete()&#xa;+ getApproved()&#xa;+ toggleLike()&#xa;+ toggleSave()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1">
      <mxGeometry x="420" y="80" width="250" height="270" as="geometry" />
    </mxCell>

    <!-- Class: Comment -->
    <mxCell id="cls_comment" value="Comment&#xa;---------------------------------&#xa;+ id: String [PK]&#xa;+ post_id: String [FK]&#xa;+ parent_id: String [FK, Nullable]&#xa;+ user_id: String [FK, Nullable]&#xa;+ author_name: String&#xa;+ content: Text&#xa;+ is_ai_bot: Boolean&#xa;+ created_at: Timestamp&#xa;---------------------------------&#xa;+ create()&#xa;+ delete()&#xa;+ getByPostId()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1">
      <mxGeometry x="780" y="80" width="240" height="230" as="geometry" />
    </mxCell>

    <!-- Class: PostLike -->
    <mxCell id="cls_like" value="PostLike&#xa;---------------------------------&#xa;+ id: String [PK]&#xa;+ post_id: String [FK]&#xa;+ user_id: String [FK]&#xa;+ created_at: Timestamp" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1">
      <mxGeometry x="420" y="420" width="180" height="110" as="geometry" />
    </mxCell>

